generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  SAVINGS
  CASH
  MOBILE_WALLET
  CRYPTO
  INVESTMENT
  CREDIT_CARD
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
}

model Account {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  icon           String?
  color          String?
  currency       String   @default("USD")
  openingBalance Decimal  @default(0) @db.Decimal(20, 8)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionsFrom   Transaction[]      @relation("SourceAccount")
  transactionsTo     Transaction[]      @relation("DestinationAccount")
  balanceAdjustments BalanceAdjustment[]

  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  kind      CategoryKind
  parentId  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]

  @@index([userId])
  @@index([parentId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  accountId   String
  toAccountId String?
  categoryId  String?
  type        TransactionType
  amount      Decimal         @db.Decimal(20, 8)
  date        DateTime
  merchant    String?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account   @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount  Account?  @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([date])
}

model BalanceAdjustment {
  id                String   @id @default(cuid())
  accountId         String
  calculatedBalance Decimal  @db.Decimal(20, 8)
  actualBalance     Decimal  @db.Decimal(20, 8)
  difference        Decimal  @db.Decimal(20, 8)
  note              String?
  createdAt         DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
