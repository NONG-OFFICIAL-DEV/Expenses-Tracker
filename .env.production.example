# Copy this to /opt/expense-tracker/.env on the server. Never commit the real file.

POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=expense_tracker

JWT_ACCESS_SECRET=change-me-to-a-long-random-value
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-value

# The origin the browser loads the web app from — must match exactly (scheme + host + port)
# for CORS/cookies to work. Update this once you have a domain and switch to https://.
WEB_ORIGIN=http://YOUR_SERVER_IP
